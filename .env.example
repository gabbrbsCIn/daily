# Senha de acesso ao app (login de senha única).
APP_SENHA=
# Segredo para assinar o cookie de sessão. Gere com: openssl rand -hex 32
SESSAO_SEGREDO=
# Postgres de produção (Neon ou Supabase). Sem ela, o app usa PGlite em .pglite/.
DATABASE_URL=
# Chave da API-Football, para o Pernambucano (plano grátis: temporadas 2022 a 2024).
API_FOOTBALL_KEY=
