# Login (Neon Auth). A URL fica no Console da Neon: Branch → Auth → Configuration.
NEON_AUTH_BASE_URL=
# Segredo dos cookies de sessão, com 32 caracteres ou mais. Gere com: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=
# E-mail do dono: só ele vê o botão que carrega a lista inicial de jogos (dados/diario_inicial.json).
DONO_EMAIL=
# Postgres de produção (Neon). Sem ela, o app usa PGlite em .pglite/.
DATABASE_URL=
# Chave da API-Football, para o Pernambucano (plano grátis: temporadas 2022 a 2024).
API_FOOTBALL_KEY=
